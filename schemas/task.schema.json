{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmjtechno/kmj-forge/schemas/task.schema.json",
  "title": "KMJ Forge Task",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "acceptance_criteria",
    "constraints",
    "requested_capabilities"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {
      "type": "array",
      "items": {"type": "string"}
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requested_capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
